# dongta-django 환경 설정
# .env 로 복사 후 실제 값 입력 (절대 git 커밋 금지)

# Django
SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,www.dongta.com

# PostgreSQL (신규)
DATABASE_URL=postgresql://dongta:password@localhost:5432/dongtadb

# MySQL (하이브리드 기간 - 레거시 동기화용)
MYSQL_DATABASE_URL=mysql://admin_user:password@database-dongta.rds.amazonaws.com:3306/DongtaDB

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=dongta-uploads
AWS_S3_REGION_NAME=ap-northeast-2

# JWT
JWT_ACCESS_LIFETIME_HOURS=1
JWT_REFRESH_LIFETIME_DAYS=7

# Danal 결제
DANAL_MERCHANT_ID=
DANAL_MERCHANT_KEY=
DANAL_RETURN_URL=https://www.dongta.com/api/v1/payment/danal/callback/

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@dongta.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.dongta.com
