# ========================================
# dongta-django 테스트 환경 설정 (.env.staging)
# 테스트 도메인: dongta.theuit.info
# ========================================

# Django 테스트 설정
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=test-secret-key-for-staging-please-replace-in-production
DEBUG=False
ALLOWED_HOSTS=dongta.theuit.info,www.dongta.theuit.info,api.dongta.theuit.info

# PostgreSQL (테스트 DB)
DATABASE_URL=postgresql://dongta_user:test_password@localhost:5432/dongtadb_test

# MySQL (하이브리드 기간 - 레거시 동기화용)
MYSQL_DATABASE_URL=mysql://admin_user:test_password@localhost:3306/DongtaDB

# Redis (로컬 또는 테스트 서버)
REDIS_URL=redis://localhost:6379/0

# AWS S3 (테스트 버킷)
AWS_ACCESS_KEY_ID=AKIA_TEST_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=test_secret_access_key
AWS_S3_BUCKET_NAME=dongta-test-uploads
AWS_S3_REGION_NAME=ap-northeast-2

# JWT 토큰 설정
JWT_ACCESS_LIFETIME_HOURS=1
JWT_REFRESH_LIFETIME_DAYS=7

# Danal 결제 (테스트 모드)
DANAL_CPID=TEST_CPID
DANAL_KEY=TEST_KEY
DANAL_RETURN_URL=https://dongta.theuit.info/api/v1/payment/danal/callback/

# 이메일 (테스트용 Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=test@gmail.com
EMAIL_HOST_PASSWORD=test_app_password
DEFAULT_FROM_EMAIL=test@dongta.theuit.info

# CORS 설정 (테스트)
CORS_ALLOWED_ORIGINS=https://dongta.theuit.info,https://www.dongta.theuit.info,http://localhost:3000

# Sentry (테스트 환경)
SENTRY_DSN=https://test@sentry.io/test
SENTRY_TRACES_SAMPLE_RATE=0.5

# 로그 파일 경로 (테스트)
LOG_FILE_PATH=/var/log/django/dongta-staging.log

# 환경 마커
ENVIRONMENT=staging
